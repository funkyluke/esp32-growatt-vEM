# ESP32-S3 target
CONFIG_IDF_TARGET="esp32s3"

# 16MB flash, QIO mode
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Octal (OPI) PSRAM on the ESP32-S3R8 module
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# USB Serial/JTAG as console (the board exposes USB Type-C natively)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y


# Custom partition table (larger app partition)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
# OTA: boot a new image in "pending verify"; roll back if it never confirms
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# More sockets: web server + Shelly poll + MQTT + Telegram
CONFIG_LWIP_MAX_SOCKETS=16
# Browsers send long headers (Basic auth, cookies)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# TLS for Telegram: CA bundle, buffers in PSRAM
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_USE_MALLOC=y

# Reboot if a watched task hangs
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
